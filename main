<script>
const fabrics=[
  {id:'f1',name:'Japanese Selvedge Denim',weight:'12oz',composition:'100% Cotton',color:'#4A6285',price:'€18/m',moq:'50m',supplier:'Kurabo Mills'},
  {id:'f2',name:'Italian Linen Twill',weight:'180gsm',composition:'100% Linen',color:'#C8B89A',price:'€14/m',moq:'30m',supplier:'Albini Group'},
  {id:'f3',name:'Merino Wool Flannel',weight:'280gsm',composition:'100% Merino',color:'#8B7355',price:'€22/m',moq:'25m',supplier:'Loro Piana'},
  {id:'f4',name:'Organic Cotton Poplin',weight:'120gsm',composition:'100% Organic Cotton',color:'#E8DDD0',price:'€9/m',moq:'50m',supplier:'BCI Cotton'},
  {id:'f5',name:'Recycled Nylon Ripstop',weight:'90gsm',composition:'80% rNylon 20% Elastane',color:'#2D4A3E',price:'€12/m',moq:'40m',supplier:'Econyl'},
  {id:'f6',name:'Deadstock Silk Charmeuse',weight:'75gsm',composition:'100% Silk',color:'#D4A0A0',price:'€28/m',moq:'10m',supplier:'Various'}
];

let techpacks=[
  {id:1,name:'Classic Oxford Shirt',category:'Tops',fabricId:'f4',trims:['Organic Poplin','MOP buttons','Interlining'],buttons:7,fabricUse:1.8,producer:'Atelier Lisbon',colorway:'White / Blue stripe',status:'Active',ean:'5901234100001',tracking:{number:'PostNL1234567',status:'delivered'},notes:'French seams, single needle topstitch.'},
  {id:2,name:'5-Pocket Slim Jean',category:'Bottoms',fabricId:'f1',trims:['Selvedge Denim','YKK zip','Rivets'],buttons:1,fabricUse:1.5,producer:'Manifattura Riese',colorway:'Raw indigo',status:'Active',ean:'5901234100002',tracking:{number:'DHL9876543',status:'transit'},notes:'Chain stitch hem, bar-tack reinforcements.'},
  {id:3,name:'Unstructured Blazer',category:'Outerwear',fabricId:'f3',trims:['Merino Flannel','Bemberg lining','Horn buttons'],buttons:2,fabricUse:2.2,producer:'Sartoria Napoli',colorway:'Charcoal melange',status:'Draft',ean:'5901234100003',tracking:{number:'',status:'none'},notes:'Half-canvas construction.'},
  {id:4,name:'Linen Camp Shirt',category:'Tops',fabricId:'f2',trims:['Linen Twill','Coconut buttons'],buttons:6,fabricUse:1.6,producer:'Atelier Lisbon',colorway:'Natural / Sage',status:'Archived',ean:'5901234100004',tracking:{number:'',status:'sent'},notes:'Flat-felled seams.'}
];

let activeTpId=null;

function badgeHtml(s){
  const m={Active:'badge-active',Draft:'badge-draft',Archived:'badge-archived'};
  return `<span class="badge ${m[s]||'badge-draft'}">${s}</span>`;
}

const shipConfig={
  none:{cls:'ship-none',icon:'ti-package',label:'No tracking'},
  sent:{cls:'ship-sent',icon:'ti-package-export',label:'Sent'},
  transit:{cls:'ship-transit',icon:'ti-truck',label:'On its way'},
  delivered:{cls:'ship-delivered',icon:'ti-circle-check',label:'Delivered'}
};

function shipPill(tp){
  const c=shipConfig[tp.tracking.status]||shipConfig.none;
  return `<span class="ship-pill ${c.cls}" onclick="openPop(event,${tp.id})"><i class="ti ${c.icon}" style="font-size:12px" aria-hidden="true"></i>${c.label}</span>`;
}

function trimTags(trims){
  return trims.slice(0,2).map(t=>`<span class="trim-tag"><i class="ti ti-tag" style="font-size:10px" aria-hidden="true"></i>${t}</span>`).join(' ')+(trims.length>2?`<span class="trim-tag">+${trims.length-2}</span>`:'');
}

function renderTable(data){
  const tbody=document.getElementById('tp-tbody');
  tbody.innerHTML=data.map(tp=>{
    const f=fabrics.find(x=>x.id===tp.fabricId);
    return `<tr>
      <td style="font-weight:500">${tp.name}<br><span style="font-size:11px;color:var(--color-text-secondary)">${tp.colorway}</span></td>
      <td><span class="ean-code">${tp.ean||'—'}</span></td>
      <td style="max-width:160px"><span style="display:flex;align-items:center;gap:4px;margin-bottom:4px"><span class="fabric-dot" style="background:${f?f.color:'#ccc'}"></span><span style="font-size:12px">${f?f.name.split(' ').slice(0,2).join(' '):'—'}</span></span><div style="display:flex;flex-wrap:wrap;gap:3px">${trimTags(tp.trims)}</div></td>
      <td>${shipPill(tp)}</td>
      <td style="text-align:center">${tp.buttons}</td>
      <td style="text-align:center">${tp.fabricUse}m</td>
      <td>${tp.producer}</td>
      <td>${badgeHtml(tp.status)}</td>
      <td><button class="action-btn" onclick="sendPrompt('Show me full details for the tech pack: ${tp.name}')"><i class="ti ti-chevron-right"></i></button></td>
    </tr>`;
  }).join('');
  document.getElementById('stat-total').textContent=techpacks.length;
  document.getElementById('stat-active').textContent=techpacks.filter(t=>t.status==='Active').length;
  document.getElementById('stat-transit').textContent=techpacks.filter(t=>t.tracking.status==='transit').length;
  document.getElementById('stat-delivered').textContent=techpacks.filter(t=>t.tracking.status==='delivered').length;
}

function filterTable(v){
  renderTable(techpacks.filter(t=>
    t.name.toLowerCase().includes(v.toLowerCase())||
    t.ean.includes(v)||
    t.producer.toLowerCase().includes(v.toLowerCase())
  ));
}

// Tracking popover
function openPop(e,id){
  e.stopPropagation();
  activeTpId=id;
  const tp=techpacks.find(t=>t.id===id);
  const pop=document.getElementById('track-pop');
  document.getElementById('pop-input').value=tp.tracking.number||'';
  renderSteps(tp.tracking.status);
  document.getElementById('pop-carrier').textContent=tp.tracking.number?'Carrier auto-detected from number format':'Enter a tracking number above to update status.';
  pop.style.display='block';
  const r=e.target.closest('.ship-pill').getBoundingClientRect();
  const appRect=document.querySelector('.app').getBoundingClientRect();
  pop.style.top=(r.bottom-appRect.top+8)+'px';
  pop.style.left=Math.min(r.left-appRect.left, appRect.width-270)+'px';
  pop.style.position='absolute';
  document.querySelector('.app').style.position='relative';
}

function closePop(){document.getElementById('track-pop').style.display='none';}

function renderSteps(status){
  const steps=[
    {key:'sent',label:'Order sent',sub:'Handed to carrier'},
    {key:'transit',label:'On its way',sub:'In transit to destination'},
    {key:'delivered',label:'Delivered',sub:'Received at destination'}
  ];
  const order=['none','sent','transit','delivered'];
  const idx=order.indexOf(status);
  document.getElementById('pop-steps').innerHTML=steps.map((s,i)=>{
    const sIdx=order.indexOf(s.key);
    let cls='step-pending', icon='ti-circle';
    if(sIdx<idx){cls='step-done';icon='ti-circle-check';}
    else if(sIdx===idx){cls='step-active';icon='ti-circle-dot';}
    return `<div class="track-step">
      <div class="track-step-icon ${cls}"><i class="ti ${icon}" style="font-size:12px" aria-hidden="true"></i></div>
      <div><div class="track-step-label" style="color:${sIdx<=idx?'var(--color-text-primary)':'var(--color-text-tertiary)'}">${s.label}</div><div class="track-step-sub">${s.sub}</div></div>
    </div>${i<2?'<div class="track-step-line"></div>':''}`;
  }).join('');
}

function applyTracking(){
  const num=document.getElementById('pop-input').value.trim();
  if(!num||!activeTpId) return;
  const tp=techpacks.find(t=>t.id===activeTpId);
  // Simulate status from tracking number format
  let status='sent';
  if(num.toUpperCase().startsWith('DHL')) status='transit';
  else if(num.toUpperCase().startsWith('POSTNL')) status='delivered';
  else if(num.length>10) status='transit';
  tp.tracking={number:num,status};
  renderSteps(status);
  const carrier=num.toUpperCase().startsWith('DHL')?'DHL Express':num.toUpperCase().startsWith('POSTNL')?'PostNL':'Auto-detected carrier';
  document.getElementById('pop-carrier').textContent='Carrier: '+carrier+' · '+num;
  renderTable(techpacks);
}

document.addEventListener('click',e=>{
  const pop=document.getElementById('track-pop');
  if(pop.style.display!=='none'&&!pop.contains(e.target)&&!e.target.closest('.ship-pill')) closePop();
});

// Fabrics tab
function renderFabrics(){
  document.getElementById('fabric-grid').innerHTML=fabrics.map(f=>`
    <div style="border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-lg);padding:1rem">
      <div style="height:44px;border-radius:6px;margin-bottom:10px;background:${f.color}"></div>
      <div style="font-weight:500;font-size:13px;margin-bottom:3px">${f.name}</div>
      <div style="font-size:11px;color:var(--color-text-secondary)">${f.composition} · ${f.weight}</div>
      <div style="font-size:11px;color:var(--color-text-secondary);margin-bottom:6px">${f.price} · MOQ ${f.moq}</div>
      <div style="font-size:11px;color:var(--color-text-tertiary)">${techpacks.filter(t=>t.fabricId===f.id).length} style(s)</div>
    </div>`).join('');
}

// Matrix tab
function renderMatrix(){
  document.getElementById('matrix-head').innerHTML='<th>Style</th>'+fabrics.map(f=>`<th><span class="fabric-dot" style="background:${f.color}"></span>${f.name.split(' ').slice(0,2).join(' ')}</th>`).join('')+'<th>Tracking</th>';
  document.getElementById('matrix-body').innerHTML=techpacks.map(tp=>{
    const cells=fabrics.map(f=>tp.fabricId===f.id?`<td style="background:#EAF3DE;color:#3B6D11;font-weight:500;text-align:center">${tp.fabricUse}m</td>`:`<td style="text-align:center;color:var(--color-text-tertiary)">—</td>`).join('');
    return `<tr><td style="font-weight:500">${tp.name}</td>${cells}<td>${shipPill(tp)}</td></tr>`;
  }).join('');
}

function showTab(tab,el){
  ['techpacks','fabrics','matrix'].forEach(t=>{document.getElementById('tab-'+t).style.display=t===tab?'':'none';});
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  if(el) el.classList.add('active');
  if(tab==='fabrics') renderFabrics();
  if(tab==='matrix') renderMatrix();
  closePop();
}

function openModal(){document.getElementById('modal').classList.add('open');}
function closeModal(){document.getElementById('modal').classList.remove('open');}
function saveNew(){
  const name=document.getElementById('new-name').value||'New Style';
  const trims=document.getElementById('new-trims').value.split(',').map(s=>s.trim()).filter(Boolean);
  techpacks.push({
    id:Date.now(),name,
    category:document.getElementById('new-cat').value,
    fabricId:'f1',trims:trims.length?trims:['Fabric TBD'],
    buttons:parseInt(document.getElementById('new-buttons').value)||0,
    fabricUse:parseFloat(document.getElementById('new-fuse').value)||1.5,
    producer:document.getElementById('new-producer').value||'TBD',
    colorway:document.getElementById('new-color').value||'TBD',
    status:document.getElementById('new-status').value,
    ean:document.getElementById('new-ean').value||'',
    tracking:{number:'',status:'none'},
    notes:document.getElementById('new-notes').value||''
  });
  renderTable(techpacks);
  closeModal();
}

renderTable(techpacks);
</script>
